# Vite public configuration. Never use privileged server keys here.
# Leave both blank for explicitly labeled, non-playable demo content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Choose the public database projection: legacy (url/thumbnail) or canonical.
NEXT_PUBLIC_VIDEO_ROW_FORMAT=legacy

# Optional owner-verified channel ID, not a title or arbitrary URL.
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
